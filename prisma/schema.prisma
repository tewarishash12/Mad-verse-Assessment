// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // or "mysql" or "sqlite" depending on your setup
  url      = env("DATABASE_URL")
}

model Pokemon {
  id      Int      @id @default(autoincrement())
  name    String   @unique
  types   Type[]
  sprite  String
}

model Type {
  id        Int       @id @default(autoincrement())
  name      String
  pokemon   Pokemon[] 
}
