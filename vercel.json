{
    "builds": [
        {
            "src": "next.config.ts",
            "use": "@vercel/next"
        }
    ],
    "routes": [
        {
            "src": "/api/trpc/(.*)",
            "dest": "/src/app/api/trpc/[trpc]/route.ts"
        },
        {
            "src": "/(.*)",
            "dest": "/$1"
        }
    ]
}